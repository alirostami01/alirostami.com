# Cloudflare Pages response policy for static documents and assets.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://comments.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://comments.app; frame-src 'self' https://comments.app; manifest-src 'self'; media-src 'self'; worker-src 'self' blob:
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# Vendor assets are pinned in the repository; cache them for repeat visits while
# retaining a bounded upgrade window because their filenames are not hashed.
/lib/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# First-party CSS and JavaScript can change without a fingerprinted filename.
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Image assets change infrequently and are safe to revalidate after 30 days.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/figures/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/software-architecture/figures/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/svg/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
